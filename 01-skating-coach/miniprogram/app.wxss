page {
  --ice-50: #f0f9ff;
  --ice-100: #e0f2fe;
  --ice-200: #bae6fd;
  --ice-300: #7dd3fc;
  --ice-500: #0284c7;
  --ice-600: #0369a1;
  --ice-700: #075985;
  --ice-800: #0c4a6e;
  --border: #cfe8f7;
  --muted: #64748B;
  --card: #ffffff;
  --text: #0f172a;
  background: var(--ice-50);
  color: var(--text);
  font-size: 15px;
}
.page { padding: 12px 12px 24px; }
.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 12px;
  margin-bottom: 12px;
}
.muted { color: var(--muted); font-size: 12px; }
.title { font-size: 17px; font-weight: 700; color: var(--ice-800); margin-bottom: 10px; }
.btn {
  background: linear-gradient(135deg, #0284c7, #0369a1);
  color: #fff; border-radius: 12px; font-size: 15px; font-weight: 600;
  padding: 11px 0; text-align: center; margin-top: 14px;
}
.btn::after { border: none; }
.ghost-btn {
  background: var(--ice-100); color: var(--ice-700); border-radius: 12px;
  font-size: 14px; font-weight: 600; padding: 11px 0; text-align: center; margin-top: 10px;
}
.ghost-btn::after { border: none; }
.field { margin-bottom: 12px; }
.field-label { display: block; font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
.textarea, .picker {
  width: 100%; box-sizing: border-box;
  border: 1px solid var(--border); border-radius: 10px;
  padding: 10px 12px; font-size: 15px; background: var(--card); color: var(--text);
}
/* ⚠️ 微信的 <input> 不吃百分比宽度：
   `width: 100%` 只撑到"文字的宽度"，后面的区域看不见也点不着；
   `min-width: 100%` 也不可靠（试过，仍然窄）。
   **可靠的写法：外面包一层 flex 容器，input 用 flex: 1 撑满。**
   所以凡是块级位置的单行输入框，都要写：
       <view class="input-wrap"><input class="input" ... /></view>
   （flex 行里的输入框不用包，它们自己就有 flex: 1） */
.input-wrap { display: flex; align-items: center; }
.input {
  flex: 1; min-width: 0; box-sizing: border-box;
  /* 兜底宽度：flex 万一在某些机型上对 <input> 不生效，这条也能让它撑开。
     微信对 <input> 不支持百分比宽度，但 rpx 是"真实数值"，它认。
     750rpx = 整屏宽；页面左右各 12px 内边距 + 卡片左右各 12px → 内容 = 750 - 96 = 654rpx */
  width: 654rpx;
  border: 1px solid var(--border); border-radius: 10px;
  padding: 10px 12px; font-size: 15px; background: var(--card); color: var(--text);
}
/* 底部弹层里的输入框：除了宽度，再加一条"跟 width 完全无关"的路 ——
   绝对定位 + left/right: 0 由偏移量决定宽度（绝对定位元素的宽度不由 width 属性决定，
   也不受"是 inline 还是 block"影响），这样就绕开了微信 input 对宽度的各种怪癖。
   实测：卡片里的输入框已经好了，弹层里的仍然窄，所以两条路都留着。 */
.sheet .input-wrap { position: relative; min-height: 52px; }
/* 只针对"包在 input-wrap 里"的（弹层里也有不包的，比如周目标那个 flex 行，不能受影响） */
.sheet .input-wrap > .input,
.sheet .input-wrap > .ta {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  width: auto; flex: none;
}
/* 单行输入/日期：加高，方便点按与编辑 */
.input, .picker { padding: 14px 12px; font-size: 16px; line-height: 1.4; }
.textarea { min-height: 90px; }
.seg { display: flex; background: var(--ice-100); border-radius: 10px; padding: 4px; gap: 5px; }
.seg-btn { flex: 1; border-radius: 9px; font-size: 15px; font-weight: 600; padding: 13px 6px; text-align: center; color: var(--ice-700); }
.seg-btn.active { background: var(--card); color: var(--ice-800); box-shadow: 0 2px 6px rgba(2,132,199,.15); }
