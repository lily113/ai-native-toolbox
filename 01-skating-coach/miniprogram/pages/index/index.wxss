.page { padding: 12px 12px 28px; }

/* 顶栏：品牌 + 设置入口 */
.home-head { display: flex; align-items: center; justify-content: space-between; margin: 2px 2px 10px; }
.brand { font-size: 17px; font-weight: 800; color: #0c4a6e; }
.gear { width: 34px; height: 34px; border-radius: 10px; background: #fff; border: 1px solid #cfe8f7; color: #0284c7; font-size: 17px; display: flex; align-items: center; justify-content: center; }

/* 月份栏 */
.month-bar { display: flex; align-items: center; justify-content: space-between; margin: 4px 4px 12px; }
.mh-btn { width: 34px; height: 34px; border-radius: 10px; background: #fff; border: 1px solid #cfe8f7; color: #0284c7; font-size: 20px; display: flex; align-items: center; justify-content: center; }
.mh-center { text-align: center; }
.mh-title { font-size: 16px; font-weight: 800; color: #0c4a6e; }
.mh-sub { display: block; font-size: 12px; color: #64748B; margin-top: 2px; }

/* 日历 */
.cal { display: flex; flex-wrap: wrap; background: #fff; border: 1px solid #cfe8f7; border-radius: 16px; padding: 10px; box-shadow: 0 2px 10px rgba(2,132,199,.06); }
.cal-wd { width: calc(100% / 7); text-align: center; font-size: 12px; color: #94a3b8; margin-bottom: 6px; }
.cal-cell { position: relative; width: calc(100% / 7); height: 42px; display: flex; align-items: center; justify-content: center; font-size: 14px; border-radius: 10px; color: #334155; flex-direction: column; }
.day-num { line-height: 1; }
.dot { position: absolute; bottom: 5px; width: 5px; height: 5px; border-radius: 50%; background: #0284c7; }
.cal-cell.sel .dot { background: #fff; }
.cal-cell.today .dot { background: #0284c7; }
.cal-cell.today.sel .dot { background: #fff; }
.cal-cell.other { color: #cbd5e1; }
.cal-cell.wknd { color: #64748B; }
.cal-cell.other.wknd { color: #dbe3ec; }
.cal-cell.today { background: #e0f2fe; font-weight: 700; color: #075985; }
.cal-cell.sel { background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; font-weight: 800; box-shadow: 0 3px 8px rgba(2,132,199,.35); }
.cal-cell.other.sel { background: transparent; color: #cbd5e1; box-shadow: none; }

/* 本月概览 */
.monthcard { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 10px 14px; margin-top: 12px; }
.mc-label { font-size: 12px; font-weight: 700; color: #075985; background: #e0f2fe; border-radius: 999px; padding: 2px 9px; }
.mc-item { font-size: 13px; color: #475569; font-weight: 600; }

/* 当日统计 */
.stats { display: flex; gap: 10px; margin: 12px 0; }
.stat { flex: 1; background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 12px 8px; text-align: center; }
.stat-num { font-size: 22px; font-weight: 800; color: #0284c7; }
.stat-label { font-size: 12px; color: #64748B; margin-top: 2px; }

/* 记录列表 */
.rec-card { background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 12px 14px 12px 16px; margin-bottom: 10px; box-shadow: 0 1px 6px rgba(2,132,199,.05); border-left-width: 5px; }
.rec-card.band-ice { border-left-color: #0284c7; }
.rec-card.band-land { border-left-color: #f59e0b; }
.rec-card.band-rehab { border-left-color: #10b981; }
.rec-card.band-other { border-left-color: #94a3b8; }
.rec-top { display: flex; align-items: center; justify-content: space-between; }
.rec-type { font-size: 15px; font-weight: 700; color: #0c4a6e; }
.rec-mode { font-weight: 500; color: #64748B; }
.rec-status { font-size: 11px; font-weight: 700; border-radius: 999px; padding: 3px 9px; }
.rec-status.ok { color: #0284c7; background: #e0f2fe; }
.rec-status.not { color: #b45309; background: #fef3c7; }
.rec-content { font-size: 14px; color: #0f172a; margin-top: 6px; word-break: break-all; white-space: pre-wrap; }
.rec-summary { font-size: 13px; color: #64748B; margin-top: 6px; line-height: 1.5; white-space: pre-wrap; }
.rec-duration { font-size: 12px; color: #64748B; margin-top: 8px; }
.empty { color: #64748B; font-size: 13px; text-align: center; padding: 22px 8px; }

/* 主按钮 + 快捷入口 */
.cta { margin-top: 4px; }
.quick { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
.quick-item { width: calc((100% - 20px) / 3); box-sizing: border-box; background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 12px 6px; text-align: center; }
.quick-icon { font-size: 22px; }
.quick-label { font-size: 12px; color: #075985; margin-top: 4px; font-weight: 600; }

/* 训练内容逐条显示 */
.rec-lines { margin-top: 8px; }
.rec-line-item { display: flex; align-items: flex-start; gap: 8px; font-size: 14px; line-height: 1.6; color: #0f172a; margin-bottom: 3px; }
.rec-line-dot { flex: none; width: 5px; height: 5px; border-radius: 50%; background: #7dd3fc; margin-top: 8px; }
.rec-line-text { flex: 1; word-break: break-all; }
.rec-more { font-size: 12px; color: #94a3b8; margin-top: 2px; }

/* 条目下的要点（来自动作库/考级，只引用不复制） */
.rec-line-body { flex: 1; }
.rec-pt { font-size: 12.5px; color: #64748B; line-height: 1.6; margin-top: 1px; padding-left: 2px; }
.rec-pt-more { font-size: 11px; color: #94a3b8; margin-top: 1px; }

/* 固定底部“添加训练” */
.page { padding-bottom: calc(104px + env(safe-area-inset-bottom)); }
.fab-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: 10px 12px calc(12px + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f0f9ff 72%, rgba(240,249,255,0)); }
.fab { margin: 0; box-shadow: 0 6px 16px rgba(2,132,199,.28); }
