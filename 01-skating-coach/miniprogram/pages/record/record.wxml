<view class="page">
  <view class="card">
    <view class="field">
      <view class="field-label">类型 *<text class="edit-link" wx:if="{{!id}}" bindtap="copyLast">⚡ 复制上次</text></view>
      <view class="seg">
        <view class="seg-btn {{type === item.k ? 'active' : ''}}" wx:for="{{types}}" wx:key="k" bindtap="setType" data-k="{{item.k}}">{{item.e}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">训练方式 *</view>
      <view class="seg">
        <view class="seg-btn {{mode === item.k ? 'active' : ''}}" wx:for="{{modes}}" wx:key="k" bindtap="setMode" data-k="{{item.k}}">{{item.e}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">日期 *</view>
      <picker mode="date" value="{{date}}" bindchange="setDate">
        <view class="picker">{{date}}</view>
      </picker>
    </view>

    <view class="field">
      <view class="field-label">训练时间（可选）</view>
      <view class="time-row">
        <picker class="time-wrap" mode="multiSelector" range="{{startRange}}" value="{{startIdx}}"
                bindchange="setStart" bindcolumnchange="onStartCol">
          <view class="time-pick {{timeStart ? 'set' : ''}}">
            <text class="tp-label">开始</text>
            <text class="tp-value {{timeStart ? '' : 'ph'}}">{{timeStart || '--:--'}}</text>
          </view>
        </picker>
        <view class="time-arrow">→</view>
        <picker class="time-wrap" mode="multiSelector" range="{{endRange}}" value="{{endIdx}}"
                bindchange="setEnd" bindcolumnchange="onEndCol">
          <view class="time-pick {{timeEnd ? 'set' : ''}}">
            <text class="tp-label">结束</text>
            <text class="tp-value {{timeEnd ? '' : 'ph'}}">{{timeEnd || '--:--'}}</text>
          </view>
        </picker>
        <view class="time-clear" wx:if="{{timeStart || timeEnd}}" bindtap="clearTime">×</view>
      </view>
      <view class="time-manual" bindtap="manualTime">✎ 手动输入精确时间（如 15:08）</view>
      <view class="time-hint" wx:if="{{timeHint}}">{{timeHint}}</view>
    </view>

    <block wx:if="{{mode === 'lesson'}}">
      <view class="field">
        <view class="field-label">节数（1 节 = 30 分钟，时长自动算）</view>
        <view class="seg">
          <view class="seg-btn {{units == item ? 'active' : ''}}" wx:for="{{unitOptions}}" wx:key="*this"
                bindtap="setUnits" data-v="{{item}}">{{item}} 节</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">上课形式</view>
        <view class="seg">
          <view class="seg-btn {{lessonForm == item.k ? 'active' : ''}}" wx:for="{{formOptions}}" wx:key="k"
                bindtap="setLessonForm" data-k="{{item.k}}">{{item.n}}</view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">时长</view>
        <view class="ro-time">⏱ {{duration}} 分钟（{{units}} 节 × 30 分钟）</view>
      </view>
    </block>

    <view class="field" wx:else>
      <view class="field-label">时长（分钟）</view>
      <view class="seg">
        <view class="seg-btn {{duration == item ? 'active' : ''}}" wx:for="{{durOptions}}" wx:key="*this"
              bindtap="setDuration" data-v="{{item}}">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="field-label">训练笔记（可选）</view>
      <textarea class="textarea note" value="{{content}}" data-k="content" bindinput="input" auto-height placeholder="勾选动作/考级会自动写入条目；这里可补充要点、教练的话、身体状态、下次目标…" maxlength="-1"></textarea>
      <view class="orphan-tip" wx:if="{{orphanCount}}">
        <text>有 {{orphanCount}} 行条目和当前勾选对不上（动作/考级已删除或没勾上），取消勾选删不掉</text>
        <text class="orphan-do" bindtap="cleanOrphans">清理这几行</text>
      </view>
      <view class="sel-block" wx:if="{{orderRows.length > 1}}">
        <view class="sel-head">已选 · 用 ↑ ↓ 调整顺序（动作 = 整组移动；动作内的组合 = 组内移动）</view>
        <view class="sel-list">
          <view class="sort-row {{item.kind === 'head' ? 'head' : 'item'}} {{item.indent ? 'indent' : ''}} {{item.tag ? 'tag' : ''}}"
                wx:for="{{orderRows}}" wx:key="key">
            <view class="sr-chev" wx:if="{{item.kind === 'head'}}" catchtap="toggleGroup" data-key="{{item.key}}">{{item.open ? '▾' : '▸'}}</view>
            <view class="sr-text">
              <view class="sr-name {{item.kind === 'head' ? 'hd' : ''}}">{{item.label}}</view>
              <view class="sr-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
            </view>
            <view class="sr-ops">
              <view class="sr-btn" catchtap="moveRow" data-key="{{item.key}}" data-dir="-1">↑</view>
              <view class="sr-btn" catchtap="moveRow" data-key="{{item.key}}" data-dir="1">↓</view>
            </view>
          </view>
        </view>
      </view>
    </view>


<view class="field">
      <view class="field-label">训练动作 / 练习组合（可选）</view>
      <view class="mv-hint">点动作名 = 全选 / 取消它下面的组合；只想练其中几个就单独点组合（父框会显示 −）。组合全取消，这个动作也就不算记录了。</view>
      <view class="mv-search">
        <input class="mv-input" value="{{moveQuery}}" bindinput="onMoveQuery" placeholder="搜索动作或组合…" confirm-type="search" />
        <view class="mv-clear" wx:if="{{moveQuery}}" bindtap="clearMoveQuery">×</view>
        <view class="mv-recent {{recentOnly ? 'on' : ''}}" bindtap="toggleRecent">最近用过</view>
        <view class="mv-recent {{onlyPicked ? 'on' : ''}}" bindtap="toggleOnlyPicked">只看已勾选{{selMoveIds.length ? " " + selMoveIds.length : ""}}</view>
      </view>
      <view class="mv-picked" wx:if="{{selMoveIds.length || selExamIds.length}}">
        这条记录已勾选：{{selMoveIds.length}} 个动作 · {{selDrillIds.length}} 个组合 · {{selExamIds.length}} 个考级
      </view>
      <view class="mv-list" wx:if="{{viewMoves.length}}">
        <view class="mv" wx:for="{{viewMoves}}" wx:for-item="mv" wx:key="id">
          <view class="mv-head" bindtap="toggleMove" data-id="{{mv.id}}">
            <view class="mv-check {{mv.allOn ? 'on' : ''}} {{mv.partOn ? 'part' : ''}}">{{mv.allOn ? '✓' : (mv.partOn ? '−' : '')}}</view>
            <view class="mv-name">{{mv.name}}</view>
            <view class="mv-cat">{{mv.catName}}</view>
          </view>
          <view class="mv-drills" wx:if="{{(mv.checked || moveQuery) && mv.drills.length}}">
            <view class="dr" wx:for="{{mv.drills}}" wx:for-item="dr" wx:key="id"
                  bindtap="toggleDrill" data-mid="{{mv.id}}" data-did="{{dr.id}}">
              <view class="dr-check {{dr.checked ? 'on' : ''}}">{{dr.checked ? '✓' : ''}}</view>
              <view class="dr-name">{{dr.name}}</view>
            </view>
          </view>
        </view>
      </view>
      <view class="muted" wx:else>{{onlyPicked ? "" : "没有匹配的动作，"}}{{emptyHint}}。</view>
    </view>

    <view class="field">
      <view class="field-label">考级备考（可选）</view>
      <block wx:if="{{examList.length}}">
        <view class="dr" wx:for="{{examList}}" wx:for-item="ex" wx:key="id"
              bindtap="toggleExam" data-id="{{ex.id}}">
          <view class="dr-check {{ex.checked ? 'on' : ''}}">{{ex.checked ? '✓' : ''}}</view>
          <view class="dr-name">{{ex.label}}</view>
        </view>
        <view class="muted">只列出你在「考级」页 ☆ 关注过的级别。</view>
      </block>
      <view class="muted" wx:else>
        这里只放你关注的级别。到「考级」页点 ☆ 关注后就会出现在这里。
        <text class="lnk" bindtap="goExams">去考级页</text>
      </view>
    </view>

  </view>

  <view class="footer">
    <button class="ghost-btn del" wx:if="{{id}}" bindtap="del">删除</button>
    <button class="btn save-btn" bindtap="save">保存</button>
  </view>
</view>
