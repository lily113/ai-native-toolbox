.rv-head { display: flex; align-items: center; justify-content: space-between; margin: 4px 4px 14px; }
.rv-btn { width: 34px; height: 34px; border-radius: 10px; background: #fff; border: 1px solid #cfe8f7; color: #0284c7; font-size: 20px; display: flex; align-items: center; justify-content: center; }
.rv-title { font-size: 16px; font-weight: 800; color: #0c4a6e; }

.rv-grid { display: flex; gap: 10px; margin-bottom: 10px; }
.rv-card.big { flex: 1; text-align: center; padding: 13px 10px;
  display: flex; flex-direction: column; align-items: center; justify-content: center; }
/* 等高不用 min-height：两张卡在 flex 行里 align-items 默认 stretch，内容高的那张决定行高 */
.rv-num { font-weight: 800; color: #0284c7; line-height: 1.15; white-space: nowrap; }
.rv-num.num-lg { font-size: 26px; }
.rv-num.num-md { font-size: 22px; }
.rv-num.num-sm { font-size: 19px; }
.rv-num.num-xs { font-size: 16px; }
.rv-lb { font-size: 12px; color: #64748B; margin-top: 4px; }
.rv-card { background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; }
.rv-row { display: flex; gap: 10px; margin-top: 8px; }
.rv-item { flex: 1; text-align: center; background: #f0f9ff; border-radius: 12px; padding: 10px 6px; }
.rv-val { font-size: 16px; font-weight: 700; color: #0f172a; }
.rv-item .rv-lb { margin-top: 2px; }

.bar { height: 8px; background: #e2eef6; border-radius: 999px; overflow: hidden; margin: 8px 0 2px; }
.bar-fill { height: 100%; background: linear-gradient(135deg, #0284c7, #0369a1); border-radius: 999px; }

.empty { color: #64748B; text-align: center; padding: 40px 8px; font-size: 14px; }

/* 12 个月趋势柱状 */
.trend { display: flex; align-items: flex-end; gap: 4px; margin: 8px 0 4px; }
.tr-col { flex: 1; text-align: center; }
.tr-wrap { height: 78px; display: flex; align-items: flex-end; justify-content: center; }
.tr-bar { width: 62%; min-height: 3px; background: #bae6fd; border-radius: 5px 5px 0 0; transition: height .2s; }
.tr-bar.cur { background: #0284c7; }
.tr-lb { font-size: 10px; color: #94a3b8; margin-top: 4px; }
/* 类型占比条 */
.type-bar { display: flex; height: 12px; border-radius: 999px; overflow: hidden; margin: 8px 0; background: #eef6fb; }
.tb-seg.ice { background: #0284c7; }
.tb-seg.land { background: #38bdf8; }
.tb-seg.rehab { background: #a5b4fc; }
.tb-legend { display: flex; flex-wrap: wrap; gap: 12px; }
.tb-item { font-size: 12px; color: #475569; display: flex; align-items: center; }
.tb-dot { width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; display: inline-block; }
.tb-dot.ice { background: #0284c7; }
.tb-dot.land { background: #38bdf8; }
.tb-dot.rehab { background: #a5b4fc; }

.rv-sub { font-size: 12px; color: #64748B; margin-top: 8px; }
.rv-actions { margin: 24rpx 24rpx 40rpx; }

/* 训练结构（按次数） */
.st-head { font-size: 12.5px; font-weight: 700; color: #075985; margin: 10px 0 6px; }
.st-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.st-name { flex: none; width: 84px; font-size: 12.5px; color: #334155; }
.st-bar { flex: 1; height: 8px; background: #e2eef6; border-radius: 999px; overflow: hidden; }
.st-fill { height: 100%; border-radius: 999px; }
.st-fill.ice { background: linear-gradient(135deg, #0284c7, #0369a1); }
.st-fill.land { background: linear-gradient(135deg, #a855f7, #7c3aed); }
.st-n { flex: none; width: 46px; text-align: right; font-size: 12px; color: #64748B; }
.st-note { font-size: 11.5px; color: #94a3b8; line-height: 1.55; margin-top: 8px; }

/* 上冰 / 陆地 拆开对账 */
.rv-card.split { padding: 10px 14px; }
.sp-row { display: flex; justify-content: space-between; align-items: baseline; padding: 2px 0; }
.sp-k { font-size: 13px; color: #334155; }
.sp-v { font-size: 13.5px; font-weight: 700; color: #075985; }
.sp-note { font-size: 11.5px; color: #94a3b8; margin-top: 6px; line-height: 1.5; }

/* 教练 / 老师（本月） */
.coach-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 3px 0; }
.coach-n { font-size: 13.5px; color: #0c4a6e; font-weight: 600; }
.coach-c { font-size: 12.5px; color: #64748B; }
.coach-split { color: #94a3b8; }

/* 冰感（本月） */
.feel-top { display: flex; align-items: baseline; gap: 6px; margin-top: 6px; }
.feel-avg { font-size: 30px; font-weight: 800; color: #0284c7; line-height: 1; }
.feel-unit { font-size: 12.5px; color: #64748B; }
.feel-dist { margin-top: 8px; font-size: 12.5px; color: #334155; line-height: 1.6; }
.feel-cmp { margin-top: 10px; padding-top: 10px; border-top: 1px solid #eef4f8; }
.fc-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 3px 0; }
.fc-k { font-size: 12.5px; color: #475569; }
.fc-v { font-size: 12.5px; font-weight: 700; color: #075985; }
.feel-note { margin-top: 8px; font-size: 11.5px; color: #94a3b8; line-height: 1.55; }

/* 冰鞋一行 */
.skate-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
.sk-name { font-size: 13.5px; font-weight: 700; color: #0c4a6e; }
.sk-v { font-size: 12.5px; color: #0284c7; }
