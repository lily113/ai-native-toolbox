.rv-head { display: flex; align-items: center; justify-content: space-between; margin: 4px 4px 14px; }
.rv-btn { width: 34px; height: 34px; border-radius: 10px; background: #fff; border: 1px solid #cfe8f7; color: #0284c7; font-size: 20px; display: flex; align-items: center; justify-content: center; }
.rv-title { font-size: 16px; font-weight: 800; color: #0c4a6e; }

.rv-grid { display: flex; gap: 10px; margin-bottom: 10px; }
.rv-card.big { flex: 1; text-align: center; padding: 16px 10px; }
.rv-num { font-size: 26px; font-weight: 800; color: #0284c7; }
.rv-lb { font-size: 12px; color: #64748B; margin-top: 4px; }
.rv-card { background: #fff; border: 1px solid #cfe8f7; border-radius: 14px; padding: 12px 14px; margin-bottom: 10px; }
.rv-row { display: flex; gap: 10px; margin-top: 8px; }
.rv-item { flex: 1; text-align: center; background: #f0f9ff; border-radius: 12px; padding: 10px 6px; }
.rv-val { font-size: 16px; font-weight: 700; color: #0f172a; }
.rv-item .rv-lb { margin-top: 2px; }

.bar { height: 8px; background: #e2eef6; border-radius: 999px; overflow: hidden; margin: 8px 0 2px; }
.bar-fill { height: 100%; background: linear-gradient(135deg, #0284c7, #0369a1); border-radius: 999px; }

.empty { color: #64748B; text-align: center; padding: 40px 8px; font-size: 14px; }
