<view class="page">
  <view class="rv-head">
    <text class="rv-btn" bindtap="prev">‹</text>
    <picker mode="date" fields="month" value="{{ymValue}}" bindchange="onDate">
      <view class="rv-title">{{stats.label}} ▾</view>
    </picker>
    <text class="rv-btn" bindtap="next">›</text>
  </view>

  <block wx:if="{{stats.count}}">
    <view class="rv-grid">
      <view class="rv-card big"><view class="rv-num {{stats.countCls}}">{{stats.count}}</view><view class="rv-lb">训练次数</view></view>
      <view class="rv-card big"><view class="rv-num {{stats.minutesCls}}">{{stats.minutesText}}</view><view class="rv-lb">总时长</view></view>
    </view>
    <view class="rv-card split">
      <view class="sp-row"><text class="sp-k">⛸️ 上冰</text><text class="sp-v">{{stats.iceMinText}}</text></view>
      <view class="sp-row"><text class="sp-k">🏋️ 陆地</text><text class="sp-v">{{stats.landMinText}}</text></view>
      <view class="sp-note">上冰是主课（看上面的周目标）；陆地是辅助，只在这张表里对账。</view>
    </view>

    <view class="rv-card">
      <view class="rv-lb">近 12 个月上冰次数（月度最高 {{stats.trendMax}} 次）</view>
      <view class="trend">
        <view class="tr-col" wx:for="{{stats.trend}}" wx:key="label">
          <view class="tr-wrap"><view class="tr-bar {{item.current ? 'cur' : ''}}" style="height:{{item.h}}%"></view></view>
          <view class="tr-lb">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="rv-card" wx:if="{{stats.typeBar.length}}">
      <view class="rv-lb">本月类型占比</view>
      <view class="type-bar">
        <view class="tb-seg {{item.cls}}" wx:for="{{stats.typeBar}}" wx:key="name" style="width:{{item.pct}}%"></view>
      </view>
      <view class="tb-legend">
        <view class="tb-item" wx:for="{{stats.typeBar}}" wx:key="name"><text class="tb-dot {{item.cls}}"></text>{{item.name}} {{item.n}} 次 · {{item.pct}}%</view>
      </view>
    </view>

    <view class="rv-card" wx:if="{{!stats.structure.empty}}">
      <view class="rv-lb">训练结构（本月，按次数）</view>

      <block wx:if="{{stats.structure.iceRows.length}}">
        <view class="st-head">⛸️ 上冰 · 按动作分类</view>
        <view class="st-row" wx:for="{{stats.structure.iceRows}}" wx:key="id">
          <view class="st-name">{{item.name}}</view>
          <view class="st-bar"><view class="st-fill ice" style="width:{{item.w}}%"></view></view>
          <view class="st-n">{{item.n}} 次</view>
        </view>
      </block>

      <block wx:if="{{stats.structure.landRows.length}}">
        <view class="st-head">🏋️ 陆地 · 按内容</view>
        <view class="st-row" wx:for="{{stats.structure.landRows}}" wx:key="id">
          <view class="st-name">{{item.name}}</view>
          <view class="st-bar"><view class="st-fill land" style="width:{{item.w}}%"></view></view>
          <view class="st-n">{{item.n}} 次</view>
        </view>
      </block>

      <view class="st-note" wx:if="{{stats.structure.iceRows.length}}">一次上冰可能练到多个分类（比如既练跳跃又练旋转），所以上冰那几项相加会大于上冰次数。</view>
      <view class="st-note" wx:if="{{stats.structure.iceNoMove}}">有 {{stats.structure.iceNoMove}} 次上冰没勾动作，没算进上面的分类。</view>
      <view class="st-note" wx:if="{{stats.structure.landUncat}}">陆地共 {{stats.structure.landTotal}} 次，其中 {{stats.structure.landUncat}} 次没选内容，没算进去。</view>
    </view>

    <view class="rv-card" wx:if="{{stats.coaches.length}}">
      <view class="rv-lb">教练 / 老师（本月）</view>
      <view class="coach-row" wx:for="{{stats.coaches}}" wx:key="name">
        <text class="coach-n">{{item.name}}</text>
        <text class="coach-c">{{item.n}} 次<text class="coach-split" wx:if="{{item.ice && item.land}}">（冰课 {{item.ice}} · 陆地 {{item.land}}）</text></text>
      </view>
    </view>

    <view class="rv-card">
      <view class="rv-lb">类型分布</view>
      <view class="rv-row">
        <view class="rv-item"><view class="rv-val">⛸️ {{stats.ice}}</view><view class="rv-lb">上冰</view></view>
        <view class="rv-item"><view class="rv-val">🏋️ {{stats.land}}</view><view class="rv-lb">陆地</view></view>
        <view class="rv-item" wx:if="{{stats.showRehab}}"><view class="rv-val">💪 {{stats.rehab}}</view><view class="rv-lb">康复</view></view>
      </view>
    </view>

    <view class="rv-card">
      <view class="rv-lb">上课 / 自己训练</view>
      <view class="rv-row">
        <view class="rv-item"><view class="rv-val">📖 {{stats.lesson}}</view><view class="rv-lb">冰课（{{stats.monthUnits}} 节）</view></view>
        <view class="rv-item"><view class="rv-val">🤸 {{stats.selfC}}</view><view class="rv-lb">上冰自练</view></view>
      </view>
      <view class="rv-sub">这一栏只算上冰。陆地 上课 或 自己练共 {{stats.land + stats.rehab}} 次（{{stats.landMinText}}），不按节算。</view>
      <view class="rv-sub" wx:if="{{stats.formText}}">上课形式：{{stats.formText}}</view>
    </view>

    <view class="rv-card" wx:if="{{stats.goal}}">
      <view class="rv-lb">周均上冰 {{stats.weeklyAvg}} 分钟 / 目标 {{stats.goal}} 分钟</view>
      <view class="bar"><view class="bar-fill" style="width:{{stats.goalPct}}%"></view></view>
      <view class="rv-lb">目标完成 {{stats.goalPct}}%</view>
    </view>

    <view class="rv-card">
      <view class="rv-lb">累计上冰 / 上冰课次数 / 累计节数（截至本月）</view>
      <view class="rv-row">
        <view class="rv-item"><view class="rv-val">⛸️ {{stats.allIce}}</view><view class="rv-lb">上冰</view></view>
        <view class="rv-item"><view class="rv-val">📖 {{stats.allLesson}}</view><view class="rv-lb">上冰课次数</view></view>
        <view class="rv-item"><view class="rv-val">🎯 {{stats.allUnits}}</view><view class="rv-lb">累计节数（上冰课）</view></view>
      </view>
    </view>
  </block>

  <view class="empty" wx:else>这个月还没有训练记录。</view>

  <!-- 生成一张月度报告图（保存到相册 / 分享给朋友） -->
  <view class="rv-actions" wx:if="{{stats.count}}">
    <button class="ghost-btn" bindtap="makeReport">🖼 生成这个月的报告图</button>
  </view>

  <!-- 画布：2d 模式，离屏也要挂在页面上。尺寸跟分享卡一致 540×720（导出 1080×1440） -->
  <canvas type="2d" id="reportCanvas"
          style="width:540px;height:720px;position:fixed;left:-9999px;top:0;"></canvas>
</view>
