<view class="page {{bulkOn ? 'has-bar' : ''}}">
  <view class="head-row">
    <text class="head-title">动作库</text>
    <view class="head-ops">
      <view class="sort-btn" wx:if="{{!bulkOn && !sortOn && tab !== 'all'}}" bindtap="toggleSort">⇅ 排序</view>
      <view class="sort-btn" bindtap="toggleBulk">{{bulkOn ? '✔ 完成' : '☑ 整理'}}</view>
    </view>
  </view>

  <scroll-view class="tabs-wrap" scroll-x>
    <view class="tabs">
      <view class="tab {{tab === item.k ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="k" bindtap="switchTab" data-k="{{item.k}}">{{item.name}}<text class="tab-n" wx:if="{{item.n}}">{{item.n}}</text></view>
    </view>
  </scroll-view>

  <view class="note-row" wx:if="{{!sortOn && !bulkOn}}">
    <text class="tabs-note">{{tab === 'all' ? '按最近添加排序' : '按分类查看'}}</text>
    <text class="edit-link" bindtap="openCats">⚙ 分类管理</text>
  </view>
  <view class="note-row" wx:if="{{bulkOn}}">
    <text class="tabs-note">已选 {{selCount}} 个动作</text>
    <text class="edit-link" bindtap="bulkAll">{{allSel ? '取消全选' : '全选本页'}}</text>
  </view>
  <view class="muted sort-hint" wx:if="{{sortOn}}">按住并上下拖动调整顺序，松手自动保存</view>

  <!-- 普通浏览 / 批量整理 -->
  <block wx:if="{{!sortOn}}">
    <view class="moves">
      <view class="move-card {{bulkOn && item.picked ? 'picked' : ''}}" wx:for="{{list}}" wx:key="id" bindtap="tapRow" data-id="{{item.id}}">
        <view class="pick" wx:if="{{bulkOn}}">
          <view class="pick-cb {{item.picked ? 'on' : ''}}">{{item.picked ? '✓' : ''}}</view>
        </view>
        <view class="move-body">
          <view class="move-name">{{item.name}}</view>
          <view class="move-meta">
            <text class="cat-badge">{{item.catName}}</text>
            <text class="drill-cnt">{{item.drillCount}} 个组合</text>
            <text class="move-date" wx:if="{{item.dateText}}">{{item.dateText}}</text>
          </view>
        </view>
      </view>
      <view class="empty" wx:if="{{!list.length}}">这个分类还没有动作，点下方「＋ 添加动作」</view>
    </view>
  </block>

  <!-- 拖拽排序模式（当前分类内） -->
  <block wx:else>
    <movable-area class="sort-area" style="height:{{areaH}}px">
      <movable-view class="sort-row" wx:for="{{sortList}}" wx:key="id"
                    direction="vertical" y="{{item.y}}" style="height:{{ROW_H}}px"
                    bindchange="onDragSort" data-id="{{item.id}}">
        <view class="sr-name">{{item.name}}</view>
        <view class="sr-meta">{{item.catName}}<text class="sr-cnt"> · {{item.drillCount}} 组合</text></view>
        <view class="sr-handle">≡</view>
      </movable-view>
    </movable-area>
  </block>

  <button class="btn" wx:if="{{!bulkOn}}" bindtap="add">＋ 添加动作</button>

  <view class="bulk-bar" wx:if="{{bulkOn}}">
    <view class="bb-info">已选 {{selCount}}</view>
    <view class="bb-act" bindtap="bulkMove">移到分类</view>
    <view class="bb-act danger" bindtap="bulkDel">删除</view>
  </view>
</view>
