<view class="pose">
  <!-- 环境不支持 -->
  <view class="card block" wx:if="{{!supported}}">
    <view class="block-t">此环境不可用</view>
    <view class="block-s">{{blockTip}}</view>
  </view>

  <block wx:else>
    <!-- ① 选视频 -->
    <view class="card">
      <view class="card-t">① 选择视频</view>
      <view class="card-s">相册里的训练片段（建议侧面机位、距 2.5–3.5 米、10–15 秒、只练一个动作）</view>
      <view class="row">
        <button class="btn" bindtap="pickVideo" disabled="{{analyzing}}">{{videoPath ? '重新选择视频' : '选择视频'}}</button>
        <view class="info" wx:if="{{videoInfo}}">{{videoInfo}}</view>
      </view>
      <view class="row" wx:if="{{videoPath}}">
        <view class="seg-label">采样精度</view>
        <view class="seg">
          <view class="seg-btn {{step == item ? 'active' : ''}}" wx:for="{{stepOptions}}" wx:key="*this"
                bindtap="setStep" data-v="{{item}}">{{item == 1 ? '每帧(精)' : (item == 2 ? '隔1帧(推荐)' : '隔2帧(快)')}}</view>
        </view>
      </view>
    </view>

    <!-- ② 分析 -->
    <view class="card">
      <view class="card-t">② 分析</view>
      <view class="row">
        <button class="btn {{analyzing ? 'stop' : ''}}" bindtap="{{analyzing ? 'stop' : 'analyze'}}">{{analyzing ? '停止' : '开始分析'}}</button>
        <button class="btn ghost" bindtap="testOne" disabled="{{analyzing}}">测试一帧</button>
        <view class="info">已解码 {{decoded}} 帧 · 检出 {{detected}} 帧{{cfgName ? ' · 配置 ' + cfgName : ''}}</view>
      </view>
      <view class="row">
        <view class="tag {{downscale ? 'on' : ''}}" bindtap="toggleDownscale">高分辨率降采样{{downscale ? '：开' : '：关'}}</view>
      </view>
      <view class="diag" wx:if="{{diag.length}}">
        <view class="diag-line" wx:for="{{diag}}" wx:key="index">{{item}}</view>
        <view class="diag-copy" bindtap="copyDiag">复制诊断信息</view>
      </view>
      <view class="bar-wrap" wx:if="{{analyzing}}"><view class="bar-in" style="width:{{progress}}%"></view></view>
      <view class="fmt" wx:if="{{formatNote}}">{{formatNote}}</view>
      <view class="row" wx:if="{{!heightCm}}">
        <view class="seg-label">身高（cm，用于把比例换算成厘米）</view>
        <input class="inp" type="number" value="{{heightCm}}" bindblur="setHeight" placeholder="如 160" />
      </view>
    </view>

    <!-- ④ 结果 -->
    <!-- 拍摄质量：决定这些数能不能信 -->
    <view class="q-banner q-{{quality.level}}" wx:if="{{quality}}">
      <view class="q-top">
        <text class="q-tag">{{quality.level === 'good' ? '拍摄达标' : (quality.level === 'fair' ? '人体偏小' : '拍摄不达标')}}</text>
        <text class="q-px">人体约 {{quality.px}}px 高</text>
      </view>
      <view class="q-note">{{quality.note}}</view>
      <view class="q-note2" wx:if="{{!quality.usable}}">数值已隐藏 —— 这个尺寸下的误差会吃掉判定区间。继续看骨架回放即可。</view>
      <view class="q-note2" wx:else>每个数值后面标了误差（如 ±2°），是这个尺寸下的实测噪声。</view>
    </view>

    <!-- 三个大数字（照参考产品形态：大字号、带单位、一眼能读） -->
    <view class="card" wx:if="{{big.length}}">
      <view class="card-t">③ 关键结果</view>
      <view class="big-row">
        <view class="big-cell" wx:for="{{big}}" wx:key="k">
          <view class="big-v">{{item.v}}<text class="big-u">{{item.unit}}</text></view>
          <view class="big-n">{{item.name}}</view>
          <view class="big-s">{{item.sub}}</view>
        </view>
      </view>
      <view class="concl" wx:if="{{summaryText}}">{{summaryText}}</view>
    </view>

    <!-- 最值得看的瞬间：单次分析里最有用的东西 -->
    <view class="card" wx:if="{{highlights.length}}">
      <view class="card-t">④ 最值得看的 3 个瞬间</view>
      <view class="hl" wx:for="{{highlights}}" wx:key="n" bindtap="seekTo" data-n="{{item.n}}">
        <view class="hl-l">
          <text class="hl-t">{{item.t}}</text>
          <text class="hl-lb">{{item.label}}</text>
        </view>
        <view class="hl-r">
          <text class="hl-v">{{item.value}}</text>
          <text class="hl-go">看这一帧 ›</text>
        </view>
        <view class="hl-why">{{item.why}}</view>
      </view>
      <view class="gen-tip">点任意一行 → 回放停在那一帧（画面 + 骨架）。人看 20 秒会漏，这里替你挑。</view>
    </view>

    <!-- 通用指标：跟动作无关，任何花滑动作都能看 -->
    <view class="card" wx:if="{{general.length}}">
      <view class="card-t">⑤ 通用指标（任何动作都适用）</view>
      <view class="gen-row" wx:for="{{general}}" wx:key="k">
        <view class="gen-l">
          <view class="gen-n">{{item.name}}</view>
          <view class="gen-h">{{item.hint}}</view>
        </view>
        <view class="gen-r">
          <view class="gen-v">{{item.value}}</view>
          <view class="gen-s">{{item.sub}}</view>
        </view>
      </view>
      <view class="gen-tip">这些量不针对某个动作：用来对比"同一动作的不同次""同一天的不同趟"。</view>
    </view>

    <!-- 视频 + 骨架：在原始画面上叠加关键点 -->
    <view class="card" wx:if="{{trackN}}">
      <view class="card-t">⑥ 回放：视频上叠加关键点</view>
      <view class="player-wrap">
        <canvas type="2d" id="player" class="player-canvas" style="height:{{playerH}}px"></canvas>
        <!-- 画面上的实时数字（照参考产品：时间/帧号/关键点真实量） -->
        <view class="hud" wx:if="{{hud}}">
          <view class="hud-l">Time: {{hud.t}}</view>
          <view class="hud-l">Frame: {{hud.n}}</view>
          <view class="hud-l" wx:if="{{hud.hip}}">Hip: {{hud.hip}}</view>
          <view class="hud-l" wx:if="{{hud.leg}}">LegGap: {{hud.leg}}</view>
          <view class="hud-l" wx:if="{{hud.foot}}">{{hud.foot}}</view>
        </view>
      </view>
      <view class="play-row">
        <button class="btn play-btn" bindtap="togglePlay">{{playing ? '⏸ 暂停' : '▶️ 播放（带骨架）'}}</button>
        <text class="play-time">{{playTime}}</text>
      </view>
      <view class="play-bar"><view class="play-bar-in" style="width:{{playPct}}%"></view></view>
      <view class="play-ops">
        <text class="op-chip {{showIdx ? 'on' : ''}}" bindtap="toggleIdx">{{showIdx ? '隐藏序号' : '显示序号'}}</text>
        <text class="op-hint">序号用来核对"第几号点是头/髋/踝"</text>
      </view>
      <view class="gen-tip">蓝线=骨架，黄点=关键点。看一眼就知道关键点标得准不准；视频不上传、不保存。</view>
    </view>

    <block wx:if="{{checks.length}}">
      <view class="card">
        <view class="card-t">⑦ 动作专项参考（燕式 / 步法）</view>
        <view class="gen-tip">下面四项是<text class="b">燕式转 / 步法</text>的判据；练别的动作时只看数字，不必在意"需改进"。</view>
        <view class="chk" wx:for="{{checks}}" wx:key="k">
          <view class="chk-top">
            <text class="chk-name">{{item.name}}</text>
            <text class="chk-badge {{item.state}}">{{item.text}}</text>
          </view>
          <view class="chk-val">{{item.value}}<text class="chk-sub">（{{item.sub}}）</text></view>
          <view class="chk-hint">{{item.hint}}</view>
        </view>
        <view class="stat-row" wx:for="{{stats}}" wx:key="name">
          <text class="stat-k">{{item.name}}</text><text class="stat-v">{{item.value}}</text>
        </view>
      </view>

      <view class="card">
        <view class="card-t">⑧ 曲线</view>
        <view class="row">
          <view class="tag {{chartKey === 'legGap' ? 'on' : ''}}" bindtap="switchChart" data-k="legGap">浮足高度</view>
          <view class="tag {{chartKey === 'kneeL' ? 'on' : ''}}" bindtap="switchChart" data-k="kneeL">左膝角</view>
          <view class="tag {{chartKey === 'trunk' ? 'on' : ''}}" bindtap="switchChart" data-k="trunk">上身前倾</view>
          <view class="tag {{chartKey === 'cog' ? 'on' : ''}}" bindtap="switchChart" data-k="cog">重心偏移</view>
        </view>
        <view class="chart-t">{{chartTitle}}</view>
        <canvas type="2d" id="chart" class="chart"></canvas>
      </view>
    </block>
  </block>

  <view class="work">
    <canvas type="2d" id="work1" class="work-c"></canvas>
    <canvas type="2d" id="work2" class="work-c"></canvas>
  </view>

  <view class="tips">
    <view class="tip-t">能看什么 / 不能看什么</view>
    <view class="tip-l">✅ 能看：浮足高度、两腿夹角、膝角、上身前倾/压平、重心前后偏移、单足保持时长、节奏</view>
    <view class="tip-l">❌ 不能看：<text class="b">用刃（内/外刃）</text>、跳跃高度、快速旋转圈数、定级判定</view>
    <view class="tip-t warn">免责</view>
    <view class="tip-l warn">识别的是「关节在画面里的位置」，只作<text class="b">自查参考</text>，不代表技术是否达标。</view>
    <view class="tip-t">隐私</view>
    <view class="tip-l">视频只在本机分析，<text class="b">不上传、不保存</text>；帧数据用完即丢。</view>
  </view>
  <!-- 训练建议 -->
  <view class="card" wx:if="{{advice.length}}">
    <view class="card-t">⑨ 下一步练什么</view>
    <view class="adv" wx:for="{{advice}}" wx:key="t">
      <view class="adv-t">{{item.t}}</view>
      <view class="adv-s" wx:for="{{item.s}}" wx:for-item="step" wx:key="*this">· {{step}}</view>
    </view>
    <view class="gen-tip">建议是按这段视频的数值规则生成的，<text class="b">不是教练/医生的诊断</text>；有伤病请先问专业人士。</view>
  </view>
    <!-- 高级：关键点映射（默认自动，平时不用） -->
    <view class="card">
      <view class="adv-toggle" bindtap="toggleAdv">{{advOpen ? '▾' : '▸'}} 高级：关键点映射（平时不用）</view>
      <block wx:if="{{advOpen}}">
        <view class="card-s">默认已按标准点序自动映射，<text class="b">不需要手工点</text>。只有回放时打开「显示序号」发现关节标错了位置，才需要在这里重挑一遍。</view>
        <view class="row">
          <button class="btn ghost" bindtap="startCalib" disabled="{{calibrating}}">{{calibrated ? '重新校准' : '手工校准（可选）'}}</button>
          <button class="btn ghost" wx:if="{{calibrating}}" bindtap="cancelCalib">取消</button>
          <button class="btn ghost" wx:if="{{calibrated}}" bindtap="resetCalib">恢复自动映射</button>
        </view>
        <view class="calib-box" wx:if="{{calibrating}}">
          <canvas type="2d" id="calib" class="calib-canvas" bindtap="onCanvasTap"></canvas>
          <view class="calib-zoom" bindtap="zoomBody">{{zoomed ? '↺ 还原整幅' : '🔍 放大到人（点更准）'}}{{zoomText}}</view>
          <view class="calib-tip">{{calibText}}</view>
          <view class="calib-sub">黄点是检测到的关键点（带编号），点选对应的身体位置即可</view>
        </view>
      </block>
    </view>
</view>
