.tip-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 12px; margin-bottom: 12px; }
.tip-t { font-size: 14px; font-weight: 800; color: var(--ice-800); margin-bottom: 6px; }
.tip-l { font-size: 12.5px; color: #475569; line-height: 1.6; }

.rule-hint { font-size: 12.5px; color: #0369a1; background: var(--ice-100); border-radius: 12px; padding: 10px 12px; margin-bottom: 12px; line-height: 1.6; }

.list { background: #fff; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
.row { display: flex; align-items: center; padding: 12px; border-bottom: 1px solid #eef6fc; }
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-name { font-size: 15.5px; font-weight: 700; color: var(--ice-800); }
.row-pen { font-size: 12px; color: #94a3b8; margin-left: 6px; }
.row-fixed { font-size: 10px; color: #64748b; background: #f1f5f9; border-radius: 999px; padding: 1px 6px; margin-left: 6px; }
.row-sub { font-size: 11.5px; color: #94a3b8; margin-top: 2px; }
.row-box { display: flex; align-items: center; margin-top: 7px; }
.cb { width: 16px; height: 16px; border-radius: 5px; border: 1.5px solid #cbd5e1; color: #fff; font-size: 11px; line-height: 15px; text-align: center; margin-right: 6px; }
.cb.on { background: var(--ice-500); border-color: var(--ice-500); }
.row-box-t { font-size: 12px; color: #64748b; }

.row-ops { display: flex; align-items: center; gap: 6px; flex: none; margin-left: 8px; }
.op { width: 30px; height: 30px; border-radius: 9px; background: var(--ice-100); color: var(--ice-700); font-size: 15px; font-weight: 700; line-height: 30px; text-align: center; }
.op.off { opacity: .3; }
.op.danger { background: #fee2e2; color: #dc2626; }

.foot { margin: 10px 2px 0; }
.tip { font-size: 12px; color: #94a3b8; margin-top: 10px; line-height: 1.6; }
