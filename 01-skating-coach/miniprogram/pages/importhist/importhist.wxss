.tip-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 12px; margin-bottom: 12px; }
.tip-t { font-size: 14px; font-weight: 800; color: var(--ice-800); margin-bottom: 6px; }
.tip-l { font-size: 12.5px; color: #475569; line-height: 1.65; }
.tip-l .b { font-weight: 700; color: #0369a1; }
.tip-l.dim { color: #94a3b8; margin-top: 4px; }

.paste { min-height: 200px; font-size: 13px; line-height: 1.7; }
.card .btn { margin-top: 12px; }

.sum { font-size: 13px; color: #0c4a6e; line-height: 1.6; }
.sum .b { font-size: 16px; font-weight: 800; color: #0284c7; }
.sum .warn { color: #b45309; }
.sum .dim { color: #94a3b8; }
.ops { display: flex; gap: 16px; margin: 8px 0 4px; }
.op { font-size: 12.5px; color: #0284c7; }

.row { display: flex; align-items: flex-start; gap: 10px; padding: 10px 0; border-top: 1px solid #f4f8fb; }
.chk { flex: none; width: 22px; height: 22px; border: 1.5px solid #cbd5e1; border-radius: 6px; margin-top: 2px;
  font-size: 14px; line-height: 22px; text-align: center; color: #fff; }
.chk.on { background: #0284c7; border-color: #0284c7; }
.row-main { flex: 1; min-width: 0; }
.row-main.off { opacity: .45; }
.row-top { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
.row-date { font-size: 13px; font-weight: 700; color: #0c4a6e; }
.tag { font-size: 10px; color: #64748B; background: #f1f5f9; border-radius: 999px; padding: 1px 7px; }
.tag.warn { color: #b45309; background: #fef3c7; }
.row-text { font-size: 12.5px; color: #475569; margin-top: 3px; line-height: 1.55; word-break: break-all; }

.empty { font-size: 12.5px; color: #94a3b8; line-height: 1.7; }
.empty .b { color: #0369a1; font-weight: 600; }
.sub-t { font-size: 12.5px; font-weight: 700; color: #64748B; margin-bottom: 6px; }
.no-date { font-size: 12px; color: #94a3b8; line-height: 1.6; white-space: pre-wrap; }

.ai-row { margin-top: 10px; }
.ai-row .ghost-btn { width: 100%; }
.ai-tip { font-size: 11.5px; color: #94a3b8; line-height: 1.6; margin-top: 8px; }
.ai-tip .b { color: #0369a1; font-weight: 600; }
.ai-msg { margin-top: 8px; font-size: 12px; color: #b45309; background: #fffbeb; border-radius: 8px; padding: 8px 10px; line-height: 1.6; }
.row-date.nodate { color: #b45309; font-weight: 600; }
.tag.ai { color: #7c3aed; background: #f3e8ff; }
.tag.land { color: #0f766e; background: #ccfbf1; }
.tag.dim { color: #94a3b8; }
