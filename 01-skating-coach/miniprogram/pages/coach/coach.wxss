.coach { display: flex; flex-direction: column; height: 100vh; background: #f0f9ff; }
.top { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #fff; border-bottom: 1px solid #cfe8f7; }
.top-title { font-size: 16px; font-weight: 700; color: #0c4a6e; }
.top-clear { font-size: 13px; color: #0284c7; }

.chat { flex: 1; overflow: hidden; padding: 10px 12px; box-sizing: border-box; }
.msg-row { display: flex; margin-bottom: 10px; }
.msg-row.user { justify-content: flex-end; }
.msg-row.ai { justify-content: flex-start; }
.bubble {
  max-width: 82%; padding: 9px 12px; border-radius: 12px; font-size: 15px; line-height: 1.6;
  white-space: pre-wrap; word-break: break-word;
}
.msg-row.user .bubble { background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border-bottom-right-radius: 4px; }
.msg-row.ai .bubble { background: #fff; color: #0f172a; border: 1px solid #cfe8f7; border-bottom-left-radius: 4px; }

.chat-pad { text-align: center; color: #64748B; padding-top: 60px; }
.chat-pad-title { font-size: 16px; font-weight: 700; color: #0c4a6e; margin-bottom: 12px; }
.chat-pad-sub { font-size: 13px; line-height: 1.8; color: #64748B; }

.input-row { display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid #cfe8f7; }
.inp { flex: 1; border: 1px solid #cfe8f7; border-radius: 10px; padding: 9px 11px; font-size: 15px; background: #f8fafc; color: #0f172a; }
.send { width: 84px; background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border-radius: 10px; font-size: 15px; font-weight: 600; }
.send[disabled] { opacity: .6; }

/* ============ AI 回答的结构化排版 ============ */
.bubble.ai { line-height: 1.78; font-size: 15px; padding: 12px 14px; }
.bubble.user { line-height: 1.6; }

/* 标题（# / ## / ###） */
.md-h { font-size: 16px; font-weight: 800; color: #0c4a6e; margin: 12px 0 6px; line-height: 1.5; }
.md-h:first-child { margin-top: 0; }

/* 【小标题】形式 */
.md-h2 { font-size: 15px; font-weight: 800; color: #075985; margin: 12px 0 4px; }
.md-h2:first-child { margin-top: 0; }

/* 段落 */
.md-p { margin: 4px 0; }
.md-body { flex: 1; }

/* 列表 */
.md-line { display: flex; align-items: flex-start; margin: 3px 0; }
.md-dot { flex: none; color: #0284c7; font-weight: 700; margin-right: 6px; }
.md-num { flex: none; color: #0284c7; font-weight: 700; margin-right: 6px; min-width: 18px; }

/* 加粗 */
.md-b { font-weight: 700; color: #0c4a6e; }

/* 引用 / 分隔线 / 空行 */
.md-quote { border-left: 3px solid #bae6fd; padding: 2px 0 2px 10px; color: #475569; margin: 6px 0; }
.md-hr { height: 1px; background: #e2eef6; margin: 12px 0; }
.md-gap { height: 8px; }

/* 参考来源 */
.src { margin-top: 10px; padding-top: 8px; border-top: 1px dashed #dbeafe; }
.src-head { font-size: 12px; font-weight: 700; color: #0284c7; }
.src-item { font-size: 11.5px; color: #64748B; line-height: 1.6; margin-top: 3px; }

/* 消息操作 */
.msg-ops { margin-top: 6px; text-align: right; }
.op { font-size: 11px; color: #94a3b8; padding: 2px 6px; }

/* 表格（Markdown 表格渲染成真正的表格） */
.md-table { border: 1px solid #dbeafe; border-radius: 10px; overflow: hidden; margin: 8px 0; }
.mt-row { display: flex; border-bottom: 1px solid #eaf2f9; }
.mt-row:last-child { border-bottom: none; }
.mt-head { background: #eaf4fb; }
.mt-head .mt-cell { font-weight: 700; color: #0c4a6e; }
.mt-cell { flex: 1 1 0; min-width: 0; padding: 8px 10px; font-size: 12.5px; line-height: 1.55; color: #334155;
  word-break: break-word; border-right: 1px solid #eaf2f9; }
.mt-cell:last-child { border-right: none; }
