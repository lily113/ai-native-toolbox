.coach { display: flex; flex-direction: column; height: 100vh; background: #f0f9ff; }
.top { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; background: #fff; border-bottom: 1px solid #cfe8f7; }
.top-title { font-size: 16px; font-weight: 700; color: #0c4a6e; }
.top-clear { font-size: 13px; color: #0284c7; }

.chat { flex: 1; overflow: hidden; padding: 10px 12px; box-sizing: border-box; }
.msg-row { display: flex; margin-bottom: 10px; }
.msg-row.user { justify-content: flex-end; }
.msg-row.ai { justify-content: flex-start; }
.bubble {
  max-width: 82%; padding: 9px 12px; border-radius: 12px; font-size: 15px; line-height: 1.6;
  white-space: pre-wrap; word-break: break-word;
}
.msg-row.user .bubble { background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border-bottom-right-radius: 4px; }
.msg-row.ai .bubble { background: #fff; color: #0f172a; border: 1px solid #cfe8f7; border-bottom-left-radius: 4px; }

.chat-pad { text-align: center; color: #64748B; padding-top: 60px; }
.chat-pad-title { font-size: 16px; font-weight: 700; color: #0c4a6e; margin-bottom: 12px; }
.chat-pad-sub { font-size: 13px; line-height: 1.8; color: #64748B; }

.input-row { display: flex; gap: 8px; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: #fff; border-top: 1px solid #cfe8f7; }
.inp { flex: 1; border: 1px solid #cfe8f7; border-radius: 10px; padding: 9px 11px; font-size: 15px; background: #f8fafc; color: #0f172a; }
.send { width: 84px; background: linear-gradient(135deg, #0284c7, #0369a1); color: #fff; border-radius: 10px; font-size: 15px; font-weight: 600; }
.send[disabled] { opacity: .6; }
