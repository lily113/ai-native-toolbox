<view class="page">
  <view class="head card">
    <view class="head-name" bindtap="renameMove">{{name}}<text class="rename-ico">✏️</text></view>
    <text class="cat-badge tappable" bindtap="pickCat">🏷️ {{catName}} ▾</text>
    <view class="usage-line">{{usageText}}</view>
    <view class="stat-row" wx:if="{{masteredText}}">
      <text class="stat-hint">✅ {{masteredText}}</text>
    </view>
    <button class="del-move" bindtap="delMove">删除动作</button>
  </view>
  <view class="cat-tip">点上面的分类可以把这个动作挪到别的分类（比如把「…串 / …练习」类动作归到专题练习）。</view>

  <view class="card" wx:if="{{examLinks.length}}">
    <view class="block-title">🎓 已挂到考级</view>
    <view class="pt-item" wx:for="{{examLinks}}" wx:key="index">· {{item.label}} — {{item.title}}</view>
  </view>

  <view class="card">
    <view class="block-title">💡 共性要点<text class="edit-link" bindtap="openPts">编辑</text></view>
    <view class="pt-item" wx:for="{{movePoints}}" wx:for-item="p" wx:key="index">· {{p}}</view>
    <view class="empty" wx:if="{{!movePoints.length}}">（适用于该动作下所有练习的通用要点，点「编辑」添加）</view>
  </view>

  <view class="card">
    <view class="block-title">🏷️ 练习组合（drills）<text class="edit-link" bindtap="toggleDrillSel">{{drillSelOn ? '完成' : '⇄ 移动组合'}}</text></view>
    <view class="sel-tip" wx:if="{{drillSelOn}}">点选要移动的组合（可多选，已选 {{drillPickN}} 个），再点下面的「移到别的动作」。</view>
    <view class="drill {{drillSelOn && item.picked ? 'picked' : ''}}" wx:for="{{drills}}" wx:key="id" bindtap="tapDrill" bindlongpress="delDrill" data-id="{{item.id}}">
      <view class="drill-no">{{drillSelOn ? (item.picked ? '✓' : '') : item.no}}</view>
      <text class="drill-master {{item.mastered ? 'on' : ''}}" catchtap="toggleDrillStatus" data-id="{{item.id}}">{{item.mastered ? '✅' : '○'}}</text>
      <view class="drill-body">
        <view class="drill-name">{{item.name}}<text class="drill-date" wx:if="{{item.dateText}}">{{item.dateText}}</text><text class="drill-use" wx:if="{{item.usageText}}">{{item.usageText}}</text></view>
        <view class="pt-item" wx:for="{{item.points}}" wx:for-item="pt" wx:key="index">· {{pt}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!drills.length}}">还没有组合。点按组合可改名称/要点，长按可删除。</view>
    <button class="ghost-btn" bindtap="addDrill" wx:if="{{!drillSelOn}}">＋ 添加练习组合</button>
    <button class="btn" bindtap="openPick" wx:if="{{drillSelOn}}">移到别的动作（已选 {{drillPickN}}）</button>
    <view class="sel-ops" wx:if="{{drillSelOn}}">
      <button class="ghost-btn half" bindtap="markSelMastered">✅ 标记已掌握</button>
      <button class="ghost-btn half" bindtap="markSelActive">↩︎ 退回在练</button>
    </view>
  </view>

  <view class="tip">提示：点动作名可以改名；点按组合可编辑名称与要点（可多条），长按删除；每个组合右边的 ○/✅ 是「已掌握」开关——标了就不再进「最久没练」提醒；点右上「⇄ 移动组合」可以把组合挪到别的动作下面（历史记录里的归属会一起跟过去）。</view>

  <!-- 共性要点弹层 -->
  <view class="mask {{ptsOn ? 'show' : ''}}" bindtap="closePts">
    <view class="sheet" catchtap="noop">
      <view class="sh-title">共性要点</view>
      <view class="muted">适用于该动作下所有练习组合的通用要点</view>
      <view class="field">
        <view class="pt" wx:for="{{editPts}}" wx:for-item="p" wx:key="index">
          <textarea class="ta pt-inp" value="{{p}}" data-i="{{index}}" bindinput="onPt" placeholder="要点…" maxlength="-1" auto-height></textarea>
          <view class="pt-x" data-i="{{index}}" bindtap="delPt">×</view>
        </view>
        <view class="add-pt" bindtap="addPt">＋ 添加要点</view>
      </view>
      <view class="sh-actions">
        <button class="ghost-btn" bindtap="closePts">取消</button>
        <button class="btn" bindtap="savePts">保存</button>
      </view>
    </view>
  </view>

  <!-- 移到哪个动作 弹层 -->
  <view class="mask {{pickOn ? 'show' : ''}}" bindtap="closePick">
    <view class="sheet" catchtap="noop">
      <view class="sh-title">移到哪个动作下面</view>
      <view class="muted">已选 {{drillPickN}} 个组合</view>
      <input class="ta pick-q" value="{{pickQuery}}" bindinput="onPickQuery" placeholder="搜索动作名（或组合名）…" confirm-type="search" />
      <scroll-view scroll-y class="pick-list">
        <view class="pick-row" wx:for="{{pickList}}" wx:for-item="p" wx:key="id" bindtap="doMoveDrill" data-id="{{p.id}}">
          <view class="pick-row-name">{{p.name}}</view>
          <view class="pick-row-sub">{{p.catName}} · 已有 {{p.n}} 个组合</view>
        </view>
        <view class="empty" wx:if="{{!pickList.length}}">没有匹配的动作</view>
      </scroll-view>
      <view class="sh-actions">
        <button class="ghost-btn" bindtap="closePick">取消</button>
      </view>
    </view>
  </view>

  <!-- 编辑组合弹层 -->
  <view class="mask {{editOn ? 'show' : ''}}" bindtap="closeEdit">
    <view class="sheet" catchtap="noop">
      <view class="sh-title">{{editId ? '编辑组合' : '添加组合'}}</view>
      <view class="field">
        <view class="field-label">名称</view>
        <textarea class="ta" value="{{editName}}" bindinput="onName" placeholder="如：后外点冰两周 ×10 组" maxlength="-1" auto-height></textarea>
      </view>
      <view class="field">
        <view class="field-label">新增日期（用于排序，日期越新越靠前）</view>
        <picker mode="date" value="{{editDate}}" bindchange="onDateChange">
          <view class="picker-like">{{editDate || '（未设置，点此选择）'}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">要点（可多条，可留空）</view>
        <view class="pt" wx:for="{{editPoints}}" wx:for-item="pt" wx:key="index">
          <textarea class="ta pt-inp" value="{{pt}}" data-i="{{index}}" bindinput="onPoint" placeholder="要点…" maxlength="-1" auto-height></textarea>
          <view class="pt-x" data-i="{{index}}" bindtap="delPoint">×</view>
        </view>
        <view class="add-pt" bindtap="addPoint">＋ 添加要点</view>
      </view>
      <view class="sh-actions">
        <button class="ghost-btn" bindtap="closeEdit">取消</button>
        <button class="btn" bindtap="saveEdit">保存</button>
      </view>
    </view>
  </view>
</view>
