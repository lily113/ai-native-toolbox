<view class="page">
  <view class="tip-card">
    <view class="tip-t">👥 同门小队</view>
    <view class="tip-l">一起练的人互相看<text class="b">本周上冰天数 / 上冰时长 / 冰课次数</text>。</view>
    <view class="tip-l dim">只共享这三个数字 —— <text class="b">笔记、教练的话、冰感、伤病永远不会出现在这里</text>。</view>
  </view>

  <view class="err" wx:if="{{err}}">{{err}}</view>

  <!-- ========== 还没入队：一张卡 + 两个 tab，别堆两张一模一样的卡 ========== -->
  <block wx:if="{{!loading && !joined}}">
    <view class="auth-card">
      <view class="seg">
        <view class="seg-btn {{mode === 'join' ? 'active' : ''}}" bindtap="setMode" data-m="join">加入同门</view>
        <view class="seg-btn {{mode === 'create' ? 'active' : ''}}" bindtap="setMode" data-m="create">自己建队</view>
      </view>

      <block wx:if="{{mode === 'join'}}">
        <view class="lb">邀请码</view>
        <view class="input-wrap">
          <input class="input code-input" value="{{joinCode}}" bindinput="onCode"
                 placeholder="6 位码" maxlength="6" />
        </view>
        <view class="hint">跟同门要这个 6 位码；点他分享的卡片会自动填好。</view>
      </block>
      <block wx:else>
        <view class="hint create-hint">建完会给你一个邀请码，发给同门就能进来。<text class="b">最多 15 人。</text></view>
      </block>

      <view class="lb">你在队里叫什么（可选）</view>
      <view class="input-wrap">
        <input class="input" value="{{nick}}" bindinput="onNick" placeholder="比如：小冰" maxlength="12" />
      </view>

      <button class="btn auth-btn" wx:if="{{mode === 'join'}}" bindtap="join" disabled="{{busy}}">{{busy ? '处理中…' : '加入小队'}}</button>
      <button class="btn auth-btn" wx:else bindtap="create" disabled="{{busy}}">{{busy ? '处理中…' : '创建小队'}}</button>
    </view>
    <view class="auth-foot">队伍里的人只能看到你的<text class="b">本周上冰天数 / 时长 / 冰课次数</text>。</view>
  </block>

  <!-- ========== 已在队里 ========== -->
  <block wx:if="{{!loading && joined}}">
    <!-- 邀请码：label 和两个按钮同一行，码单独占一行 ——
         原来左右两列时，<button> 的默认宽度把右边那列撑爆，盖住了码 -->
    <view class="code-card">
      <view class="cc-top">
        <text class="cc-t">邀请码</text>
        <view class="cc-ops">
          <view class="cc-btn" bindtap="copyCode">复制</view>
          <button class="cc-share" open-type="share">邀请</button>
        </view>
      </view>
      <view class="cc-code">{{code}}</view>
      <view class="cc-s">{{members}} 人在队里 · 最多 15 人</view>
    </view>

    <view class="board">
      <view class="bd-head">
        <text class="bd-t">本周榜（按上冰天数）</text>
        <text class="bd-refresh" bindtap="refreshMine">刷新我的</text>
      </view>
      <view class="row {{item.mine ? 'me' : ''}}" wx:for="{{rows}}" wx:key="nick">
        <view class="r-main">
          <view class="r-nick">{{item.nick}}<text class="r-me" wx:if="{{item.mine}}">我</text></view>
          <view class="r-sub">
            <text class="r-days">{{item.days}} 天</text>
            <text class="r-dim"> · {{item.minutesText}}</text>
            <text class="r-dim"> · 冰课 {{item.lessons}}</text>
          </view>
        </view>
        <view class="r-stale {{item.timeText === '还没更新' ? 'off' : ''}}">{{item.timeText}}</view>
      </view>
      <view class="empty" wx:if="{{!rows.length}}">队里还没有人上报数据。点上面「刷新我的」先把自己的推上去。</view>
    </view>

    <view class="quit" bindtap="leave">退出小队</view>
    <view class="foot-tip">退出后你练了多少不会丢，只是从榜上撤掉；最后一个人退出，小队会自动解散。</view>
  </block>

  <view class="loading" wx:if="{{loading}}">读取中…</view>
</view>
