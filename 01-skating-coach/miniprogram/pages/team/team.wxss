.tip-card { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 12px; margin-bottom: 12px; }
.tip-t { font-size: 14px; font-weight: 800; color: var(--ice-800); margin-bottom: 6px; }
.tip-l { font-size: 12.5px; color: #475569; line-height: 1.6; }
.tip-l .b { font-weight: 700; color: #0369a1; }
.tip-l.dim { color: #94a3b8; }

.err { background: #fde8e8; color: #b91c1c; border-radius: 10px; padding: 10px 12px; font-size: 12.5px;
  margin-bottom: 12px; line-height: 1.7; white-space: pre-wrap; word-break: break-all; }

/* 入队卡：一张卡 + 两个 tab（原来两张几乎一样的卡又长又乱） */
.auth-card { background: #fff; border: 1px solid var(--border); border-radius: 16px; padding: 14px; margin-bottom: 10px; }
.auth-card .seg { margin-bottom: 14px; }
.lb { font-size: 12px; font-weight: 600; color: #64748B; margin: 12px 2px 6px; }
.auth-card .seg + .lb, .auth-card .seg + .hint { margin-top: 0; }
.hint { font-size: 12px; color: #94a3b8; line-height: 1.6; margin: 6px 2px 0; }
.hint.create-hint { margin: 2px 2px 4px; }
.hint .b, .auth-foot .b { color: #0369a1; font-weight: 700; }

/* 输入框：高度和行高显式写死 —— 微信 input 的对齐很吃这个（不然文字会被上下裁掉） */
/* 高度 - 上下边框 = 行高，文字才能正好垂直居中（差 1~2px 就会被裁） */
.auth-card .input { height: 50px; line-height: 48px; padding: 0 14px; }
.auth-card .code-input { height: 58px; line-height: 54px; font-size: 24px; font-weight: 800;
  text-align: center; letter-spacing: 3px; background: #f8fbfe; border: 1.5px dashed #bae6fd; }
.auth-card .input-wrap { margin-bottom: 0; }
.auth-btn { margin-top: 16px; }
.auth-foot { font-size: 11.5px; color: #94a3b8; line-height: 1.6; text-align: center; padding: 0 8px; }

/* 邀请码卡 */
.code-card { display: flex; align-items: center; gap: 12px; background: #fff; border: 1px solid var(--border);
  border-radius: 14px; padding: 14px; margin-bottom: 12px; }
.cc-l { flex: 1; min-width: 0; }
.cc-t { font-size: 11.5px; color: #94a3b8; }
.cc-code { font-size: 26px; font-weight: 800; color: #0284c7; letter-spacing: 6px; margin: 2px 0; }
.cc-s { font-size: 11.5px; color: #64748B; }
.cc-ops { flex: none; display: flex; flex-direction: column; gap: 6px; }
.cc-btn { font-size: 12.5px; font-weight: 600; color: #0284c7; background: #e0f2fe; border-radius: 999px; padding: 6px 14px; text-align: center; }
.cc-share { font-size: 12.5px; font-weight: 600; color: #fff; background: #0284c7; border-radius: 999px; padding: 6px 14px; line-height: 1.5; margin: 0; }
.cc-share::after { border: none; }

/* 榜 */
.board { background: #fff; border: 1px solid var(--border); border-radius: 14px; padding: 4px 14px; }
.bd-head { display: flex; align-items: baseline; justify-content: space-between; padding: 10px 0 8px; border-bottom: 1px solid #eef4f8; }
.bd-t { font-size: 13px; font-weight: 700; color: #0c4a6e; }
.bd-refresh { font-size: 12px; color: #0284c7; }
.row { display: flex; align-items: center; gap: 10px; padding: 12px 0; border-bottom: 1px solid #f4f8fb; }
.row:last-child { border-bottom: none; }
.row.me { background: #f0f9ff; margin: 0 -14px; padding-left: 14px; padding-right: 14px; }
.r-main { flex: 1; min-width: 0; }
.r-nick { font-size: 14.5px; font-weight: 700; color: #0f172a; }
.r-me { font-size: 10px; font-weight: 700; color: #0284c7; background: #e0f2fe; border-radius: 999px; padding: 1px 7px; margin-left: 6px; }
.r-sub { font-size: 12.5px; color: #475569; margin-top: 3px; }
.r-days { font-weight: 700; color: #0369a1; }
.r-dim { color: #94a3b8; }
.r-stale { flex: none; font-size: 11px; color: #cbd5e1; }

.quit { margin-top: 18px; text-align: center; font-size: 13px; color: #b91c1c; padding: 10px 0; }
.foot-tip { margin-top: 4px; font-size: 11.5px; color: #94a3b8; line-height: 1.6; text-align: center; }
.loading { text-align: center; color: #94a3b8; font-size: 13px; padding: 30px 0; }
.empty { font-size: 12.5px; color: #94a3b8; padding: 16px 0; line-height: 1.6; }
